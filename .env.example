# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# MongoDB Connection String (optional; uses local persistent atomic file store if empty)
# Example: mongodb+srv://username:password@cluster.mongodb.net/giftora?retryWrites=true&w=majority
MONGODB_URI=""

# JWT Secret for Session & Admin Tokens (uses safe fallback in development)
JWT_SECRET="giftora-luxury-secret-key-change-in-production-2027"

# Admin Initial Credentials (configured during seed script)
INITIAL_ADMIN_EMAIL="admin@giftora.lk"
INITIAL_ADMIN_PASSWORD="GiftoraAdmin2027!"

# Node Environment
NODE_ENV="development"
